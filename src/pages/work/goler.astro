  .stat {
    padding: 24px;
    border-radius: 20px;
    background: var(--card);
  }
  .stat dt {
    font-size: clamp(40px, 4.4vw, 56px);
    line-height: 1;
    color: var(--accent);
  }
  .stat dd {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--ink-2);
  }

  /* ---------- 03 Problem ---------- */
  .chart {
    margin: 0;
    padding: clamp(20px, 3vw, 40px);
    border-radius: 24px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }
  .chart figcaption {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 52em;
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .chart strong {
    font-size: 17px;
    color: var(--ink);
  }
  .bars {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    align-items: end;
    gap: clamp(4px, 1vw, 14px);
    height: clamp(200px, 22vw, 280px);
    margin-top: 32px;
  }
  .bar-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    height: 100%;
  }
  .bar {
    width: 100%;
    min-height: 4px;
    border-radius: 6px;
    background: #4b5563;
  }
  .bar.hot {
    background: var(--accent);
  }
  :global(html.js) .bar {
    transform: scaleY(0);
    transform-origin: 50% 100%;
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0ms);
  }
  :global(html.js) .bars.in .bar {
    transform: none;
  }
  .bar-col {
    transition: opacity 0.2s ease;
  }
  .bars:hover .bar-col {
    opacity: 0.35;
  }
  .bars .bar-col:hover {
    opacity: 1;
  }
  .bar-col:hover .bar-val {
    transform: scale(1.35);
  }
  .bar-val {
    transition: transform 0.2s ease;
  }
  .bar-val {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .bar-label {
    font-size: 12px;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .examples {
    display: grid;
    gap: 24px;
  }
  .example {
    padding: 28px;
    border-radius: 20px;
    background: var(--card);
    border: 1px solid var(--card-line);
  }
  .ex-name {
    font-size: 17px;
    font-weight: 700;
  }
  .ex-row {
    display: flex;
    gap: 40px;
    margin-top: 18px;
  }
  .ex-row div {
    display: flex;
    flex-direction: column;
  }
  .ex-v {
    font-size: 22px;
    font-weight: 800;
    line-height: 1.2;
  }
  .ex-v.risk {
    color: #f59e0b;
  }
  .ex-k {
    margin-top: 2px;
    font-size: 12px;
    color: var(--ink-3);
  }
  .ex-note {
    margin-top: 18px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .footnote {
    font-size: 13px;
    color: var(--ink-3);
  }

  /* ---------- 04 Approach ---------- */
  .model {
    padding: clamp(24px, 3.4vw, 44px);
  }
  .model-title {
    font-size: clamp(24px, 2.4vw, 30px);
    letter-spacing: -0.02em;
  }
  .model-cols {
    display: grid;
    gap: 32px;
    margin-top: 28px;
  }
  .model-k {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .model-d {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .zones {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 4px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
    font-size: 11px;
    color: var(--ink-3);
  }
  .zones span {
    display: block;
    height: 10px;
    margin-bottom: 8px;
    border-radius: 999px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    padding: 6px 12px;
    border-radius: 999px;
    background: #fdf2f8; /* bg/brand-subtle */
    color: var(--accent);
    font-size: 13px;
    font-weight: 700;
  }
  .verdict {
    margin-top: 32px;
    font-size: 17px;
    color: var(--ink-2);
  }
  .verdict b {
    margin-left: 10px;
    font-weight: 900;
  }
  .go {
    color: #16a34a;
  }
  .caution {
    color: #f59e0b;
  }
  .nogo {
    color: var(--accent);
  }

  /* ---------- 05 Venue page ---------- */
  .annotated {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  .annotated-phone {
    position: relative;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
  }
  .annotated-phone :global(img) {
    width: 100%;
  }
  .hotspot {
    position: absolute;
    width: 11%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }
  .hotspot::after {
    content: '';
    position: absolute;
    inset: -18%;
    border-radius: 50%;
    border: 3px solid var(--accent);
    opacity: 0;
    transform: scale(0.7);
    transition:
      opacity 0.25s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .hotspot.on::after {
    opacity: 1;
    transform: scale(1);
    animation: ring 1.4s ease-out infinite;
  }
  @keyframes ring {
    0% { box-shadow: 0 0 0 0 rgb(191 0 86 / 0.45); }
    100% { box-shadow: 0 0 0 14px rgb(191 0 86 / 0); }
  }
  .callouts li {
    margin: -12px -16px;
    padding: 12px 16px;
    border-radius: 14px;
    cursor: default;
    transition: background 0.25s ease;
  }
  .callouts li.on {
    background: var(--card);
  }
  .callouts {
    counter-reset: c;
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .callouts li {
    counter-increment: c;
    display: grid;
    grid-template-columns: 32px 1fr;
    column-gap: 16px;
    row-gap: 4px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .callouts li::before {
    content: counter(c);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }
  .callouts b {
    font-size: 16px;
    color: var(--ink);
  }

  /* ---------- 11 AI search ---------- */
  .result {
    padding: 24px 28px;
    border-radius: 16px;
