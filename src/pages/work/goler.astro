---
// Goler case study. Built to follow the "Case study" page of the Figma file
// "Goler: Product Design": same modules, same order, same band colors and type.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import Section from '../../components/case/Section.astro';
import Notes from '../../components/case/Notes.astro';
import Shots from '../../components/case/Shots.astro';
import Wide from '../../components/case/Wide.astro';
import Zoom from '../../components/case/Zoom.astro';
import Compare from '../../components/case/Compare.astro';
import { profile } from '../../data/profile';

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/goler-shots/*.png', { eager: true });
const img = (name: string) => {
  const f = files[`../../assets/goler-shots/${name}.png`];
  if (!f) throw new Error(`Missing image: ${name}.png`);
  return f.default;
};

const base = import.meta.env.BASE_URL;

const links = {
  site: 'https://goler.co',
  appStore: 'https://apps.apple.com/app/id6784463175',
  googlePlay: 'https://play.google.com/store/apps/details?id=co.goler.app&hl=en',
};

// Problem module data (Goler data, Batumi, 2026). From 4.5★ down the bars turn brand pink.
const ratingRisk: [string, number][] = [
  ['5.0', 0.5], ['4.9', 0.9], ['4.8', 2.5], ['4.7', 3.3], ['4.6', 5.9], ['4.5', 9.0],
  ['4.4', 11.8], ['4.3', 16.2], ['4.2', 17.6], ['4.1', 18.2], ['4.0', 15.7],
];
const maxRisk = 20;

const examples = [
  { name: 'Amberleaf', stars: '4.5', risk: 25, note: 'Minor: isolated complaints' },
  { name: 'Dough & Herb+', stars: '4.6', risk: 31, note: 'Caution: recurring hygiene mentions' },
  { name: 'Indigo Tusk', stars: '4.4', risk: 47, note: 'Caution: food poisoning reports' },
];

// Chapter bar under the header: section id → label.
const chapters = [
  ['problem', 'Problem'],
  ['approach', 'Approach'],
  ['app', 'App'],
  ['website', 'Website'],
  ['venue-hub', 'Venue Hub'],
  ['admin', 'Admin'],
  ['system', 'Design system'],
  ['outcome', 'Outcome'],
];

// Callout markers on the venue page screen, in % of the image (from the Figma frame).
const hotspots = [
  { x: 90.6, y: 19.1 },
  { x: 90.6, y: 36.6 },
  { x: 90.6, y: 49.8 },
  { x: 90.6, y: 69.5 },
  { x: 73.9, y: 94.7 },
];

// Goler score tokens: score/risk-1 … score/risk-5
const zones = [
  { label: '0–20 Clean', color: '#e5e7eb' },
  { label: '20–40 Minor', color: '#fcd34d' },
  { label: '40–60 Caution', color: '#eab308' },
  { label: '60–80 Problems', color: '#d4628e' },
  { label: '80+ Critical', color: '#bf0056' },
];
---

<Base
  theme="goler"
  title={`Goler · Case study · ${profile.name}`}
  description="Product design case study: a travel app, a website, a venue dashboard and an admin console that turn thousands of reviews into a Risk score, a Quality score and one verdict."
>
  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- 01 · Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <svg class="logo" viewBox="0 0 190 52" role="img" aria-label="Goler"><g fill="currentColor"><path d="M140.469 51.1875L155.382 0H176.301C183.522 0 185.863 4.35218 183.327 13.0565L180.821 21.6619C179.063 27.6956 176.187 31.6522 172.193 33.5315L174.67 51.1875H162.989L160.794 34.6443H155.995L151.175 51.1875H140.469ZM159.388 22.9973H169.048C169.5 22.9973 169.804 22.7253 169.963 22.1813L172.794 12.4631C172.953 11.919 172.806 11.647 172.355 11.647H162.695L159.388 22.9973Z"/><path d="M106.268 51.1875L121.181 0H150.497L147.103 11.647H128.349L126.122 19.2881H143.057L139.663 30.935H122.729L120.222 39.5405H138.977L135.583 51.1875H106.268Z"/><path d="M79.3955 51.1875L94.3087 0H104.631L93.1107 39.5405H104.775L101.382 51.1875H79.3955Z"/><path d="M44.1126 38.131L51.4179 13.0565C53.9539 4.35218 58.7053 0 65.6723 0H78.9726C85.9396 0 88.1551 4.35218 85.6192 13.0565L78.3138 38.131C75.7778 46.8354 71.0264 51.1875 64.0595 51.1875H50.7591C43.7921 51.1875 41.5767 46.8354 44.1126 38.131ZM54.2713 38.7244C54.1129 39.2685 54.2514 39.5405 54.6868 39.5405H66.9183C67.3538 39.5405 67.6508 39.2685 67.8093 38.7244L75.4604 12.4631C75.6189 11.919 75.4805 11.647 75.0451 11.647H62.8134C62.378 11.647 62.0809 11.919 61.9225 12.4631L54.2713 38.7244Z"/><path d="M3.80382 38.131L11.1091 13.0565C13.6451 4.35217 18.6507 0 26.1261 0H49.0616L45.6683 11.647H23.3061C22.8389 11.647 22.5261 11.919 22.3675 12.4631L14.7165 38.7244C14.5579 39.2685 14.7123 39.5405 15.1795 39.5405H27.7302L30.2374 30.935H23.0383L26.4315 19.2881H44.7163L35.4225 51.1875H11.2128C3.73752 51.1875 1.26786 46.8354 3.80382 38.131Z"/></g></svg>
        <p class="hero-kicker">Case study · Product design</p>
        <h1 class="display">Verify restaurants. Don't fall into traps!</h1>
        <p class="hero-lead">
          A mobile app, a website, a venue dashboard and an admin console that turn thousands of real reviews into a
          risk and quality score for every venue, so travelers know where to eat before they go.
        </p>
        <div class="hero-links">
          <a class="hero-link primary" href={links.site} target="_blank" rel="noopener">Visit goler.co ↗</a>
          <a class="hero-link" href={links.appStore} target="_blank" rel="noopener">App Store ↗</a>
          <a class="hero-link" href={links.googlePlay} target="_blank" rel="noopener">Google Play ↗</a>
        </div>
        <p class="hero-note">Goler is a live product. Venue names, addresses, people and reviews shown on the screens are fictional and used for illustration only.</p>
        <dl class="hero-meta">
          <div><dt>Role</dt><dd>Product Designer</dd></div>
          <div><dt>Platform</dt><dd>iOS, Android & Web</dd></div>
          <div><dt>Year</dt><dd>2026</dd></div>
        </dl>
      </div>
      <div class="hero-visual" data-tilt>
      <Image
        class="hero-phones"
        src={img('cover-phones')}
        alt="Three Goler screens: search results, Home with the waiter character, and review analysis"
        widths={[560, 840, 1126]}
        sizes="(max-width: 900px) 100vw, 580px"
        loading="eager"
      />
      </div>
    </div>
  </section>

  <!-- Chapter bar -->
  <nav class="chapters" aria-label="Case study chapters">
    <div class="wrap chapters-inner">
      {chapters.map(([id, label]) => <a href={`#${id}`} data-target={id}>{label}</a>)}
    </div>
    <span class="progress" aria-hidden="true"></span>
  </nav>

  <!-- 02 · At a glance -->
  <Section tone="white">
    <dl class="glance-meta">
      <div><dt>Role</dt><dd>Product Designer</dd></div>
      <div><dt>Platforms</dt><dd>iOS · Android · Web</dd></div>
      <div><dt>Products</dt><dd>4 products</dd></div>
      <div><dt>Pilot city</dt><dd>Batumi, Georgia</dd></div>
    </dl>
    <div class="glance">
      <div>
        <p class="kicker">What is Goler</p>
        <h3 class="display glance-title">A travel app that checks a restaurant before you sit down</h3>
        <div class="glance-text">
          <p>
            Goler reads every public review of a venue, in every language, and turns thousands of them into two
            scores, Risk and Quality, and one verdict: GO, CAUTION or NO-GO. It never republishes reviews. It tells
            you what keeps going wrong, what people love, and what to order.
          </p>
          <p>
            I designed all four surfaces: the mobile app for travelers, goler.co, the dashboard for venue owners and
            the internal console that runs the scoring pipeline.
          </p>
        </div>
      </div>
      <dl class="stat-grid">
        <div class="stat"><dt class="display" data-count="777" data-suffix="+">777+</dt><dd>venues checked</dd></div>
        <div class="stat"><dt class="display" data-count="300" data-suffix="K+">300K+</dt><dd>reviews read</dd></div>
        <div class="stat"><dt class="display" data-count="22" data-suffix="K">22K</dt><dd>dishes indexed</dd></div>
        <div class="stat"><dt class="display" data-count="4" data-suffix="">4</dt><dd>languages</dd></div>
      </dl>
    </div>
  </Section>

  <!-- 03 · Problem -->
  <Section id="problem" chapter="Problem" n="01" tone="dark" eyebrow="The problem" title="A 4.5★ tells you nothing about the kitchen">
    <p slot="lead">
      A star rating is an average of everything: the view, the music, the price, the waiter's smile. The things that
      ruin a trip, food poisoning, a padded bill, a dirty restroom, get averaged away. Travelers have one evening in a
      new city and reviews in five languages they cannot read.
    </p>
    <figure class="chart">
      <figcaption>
        <strong>Average Risk score of Batumi venues, grouped by their Google rating</strong>
        <span>
          Goler data, 2026. Risk 0–100 shows how systematic health and safety signals are in a venue's reviews. From
          4.5★ down, the average venue already carries recurring risk signals.
        </span>
      </figcaption>
      <div class="bars" role="img" aria-label="Average Risk rises from 0.5 at 5.0 stars to about 18 at 4.1 stars">
        {
          ratingRisk.map(([stars, risk]) => (
            <div class="bar-col" style={`--d:${ratingRisk.findIndex(([s]) => s === stars) * 60}ms`}>
              <span class="bar-val">{risk.toFixed(1)}</span>
              <span class:list={['bar', { hot: Number(stars) <= 4.5 }]} style={`height:${(risk / maxRisk) * 100}%`} />
              <span class="bar-label">{stars}★</span>
            </div>
          ))
        }
      </div>
    </figure>
    <div class="examples">
      {
        examples.map((e) => (
          <div class="example">
            <p class="ex-name">{e.name}</p>
            <div class="ex-row">
              <div>
                <span class="ex-v">★ {e.stars}</span>
                <span class="ex-k">Google</span>
              </div>
              <div>
                <span class="ex-v risk">{e.risk}</span>
                <span class="ex-k">Goler Risk</span>
              </div>
            </div>
            <p class="ex-note">{e.note}</p>
          </div>
        ))
      }
    </div>
    <p class="footnote">Same stars, very different kitchens. Venue names are fictional; the pattern comes from the real Batumi data.</p>
  </Section>

  <!-- 04 · Approach -->
  <Section id="approach" chapter="Approach" n="02" tone="white" eyebrow="The approach" title="Verify, not find">
    <p slot="lead">
      Every map and review app helps you find a place. Goler does one job: it checks the place you already have in
      mind. That single job set the rules for the whole product.
    </p>
    <ol class="cards3">
      <li class="card">
        <span class="num">01</span>
        <h3>Evidence over opinion</h3>
        <p>No republished reviews, no "4.5". Two scores and a verdict, every one of them traceable to the signals behind it.</p>
      </li>
      <li class="card">
        <span class="num">02</span>
        <h3>Honest about uncertainty</h3>
        <p>When there are not enough reviews, the app says so. A verdict never claims more than the data allows.</p>
      </li>
      <li class="card">
        <span class="num">03</span>
        <h3>One job per screen</h3>
        <p>Home answers "how is this city?", Search answers "which one?", the venue page answers "should I go?". Nothing in between.</p>
      </li>
    </ol>
    <div class="model card">
      <h3 class="display model-title">Two scores instead of one average</h3>
      <div class="model-cols">
        <div>
          <p class="model-k">Risk · 0–100</p>
          <p class="model-d">How systematic the warning signals are: food poisoning, hygiene, hidden fees, hostile staff. Not a percentage of bad visits.</p>
          <ul class="zones">
            {zones.map((z) => <li><span style={`background:${z.color}`} />{z.label}</li>)}
          </ul>
        </div>
        <div>
          <p class="model-k">Quality · 0–100</p>
          <p class="model-d">How visitors actually felt, split into five categories so a great kitchen with slow service is visible as exactly that.</p>
          <ul class="chips">
            <li>Food & Drink</li>
            <li>Service & Staff</li>
            <li>Cleanliness & Safety</li>
            <li>Value & Billing</li>
            <li>Experience & Operations</li>
          </ul>
        </div>
      </div>
      <p class="verdict">
        Together they give one verdict: <b class="go">GO</b> <b class="caution">CAUTION</b> <b class="nogo">NO-GO</b>
      </p>
    </div>
  </Section>

  <!-- 05 · Venue page -->
  <Section id="app" chapter="App" n="03" tone="sand" eyebrow="Solution · Venue page" title={'One screen answers "should I go?"'}>
    <p slot="lead">
      The venue page opens on the verdict, not on photos. Risk and Quality sit above the fold with the number of
      reviews behind them; the category breakdown explains the trade-off; one swipe opens the evidence.
    </p>
    <div class="annotated">
      <div class="annotated-phone">
        <Image src={img('venue-phone')} alt="Venue page of Lazurna House with five numbered callouts" widths={[420, 840]} sizes="420px" loading="lazy" />
        {hotspots.map((h, i) => (
          <button type="button" class="hotspot" data-spot={i} style={`left:${h.x}%;top:${h.y}%`} aria-label={`Callout ${i + 1}`} />
        ))}
      </div>
      <ol class="callouts" data-callouts>
        <li><b>Name, type, price range and a one-line description</b><span>Enough to confirm it is the right place. "See more" hides the rest.</span></li>
        <li><b>Hours and the three things you do next</b><span>Open or closed right now; Menu, Location and Contacts as actions, not tabs.</span></li>
        <li><b>Risk and Quality side by side</b><span>Two numbers with the review count behind them. Color comes from the zone, not from the brand.</span></li>
        <li><b>Category breakdown</b><span>Food, Service, Cleanliness, Value, Experience: each scored only on the reviews that mention it.</span></li>
        <li><b>"Review analysis" is one swipe away</b><span>The evidence lives on the next screen, so the first one stays readable at a glance.</span></li>
      </ol>
    </div>
    <div class="pair">
      <Zoom src={img('venue-score')} alt="Score card: Risk and Quality, the review count, and a breakdown by category" widths={[568, 1136]} sizes="(max-width: 760px) 100vw, 568px" />
      <Zoom src={img('venue-analysis')} alt="Review analysis: the verdict in one sentence, then the top risks and concerns" widths={[568, 1136]} sizes="(max-width: 760px) 100vw, 568px" />
    </div>
  </Section>

  <!-- 06 · Home before and after -->
  <Section n="04" tone="white" eyebrow="Iteration · Home" title="Home, before and after">
    <p slot="lead">
      The first Home opened with three category doors and a link to the scoring methodology. The redesign puts the
      main action first, checking a venue, and gives the brand a face.
    </p>
    <div class="ba">
      <Compare before={img('home-before-phone')} after={img('home-after-phone')} beforeLabel="Before · June 2026" afterLabel="After · today" />
      <Notes stack
      items={[
        {
          label: 'Before · what worked, what did not',
          text: [
            '+ Three category circles showed the scope at a glance: apartments, food, hotels.',
            '+ The methodology link was on the first screen.',
            '− Two of the three circles were locked, so most of the hero promised what was not there yet.',
            '− No search: the main action, checking a venue, was missing from Home.',
            '− Insights were bare facts ("69% of venues have their menu available on Goler") with no benefit for the traveler.',
            '− The contest card brought App Store rejections over contest rules (guidelines 2.3.6 and 5.3.2).',
          ],
        },
        {
          label: 'After · what works, what it costs',
          text: [
            '+ Search sits in the hero, labelled "Check a venue": verify, not find.',
            '+ Insights lead with the promise and keep the number as proof: "5% of venues here have food poisoning reports. We tell you which ones."',
            '+ The waiter character gives the brand a face and can change per city: a local hat, a local dish.',
            '− The illustration takes the top of the screen and pushes the numbers down.',
            '− Only food is shown; the other categories are no longer visible on Home.',
            "− The methodology link left Home. The explanation now sits next to a venue's score, where the question comes up.",
          ],
        },
      ]}
    />
    </div>
  </Section>

  <!-- 07 · Evidence -->
  <Section n="05" tone="sand" eyebrow="Solution · Evidence" title="Show the receipts">
    <p slot="lead">
      A score nobody can check is just another opinion. Behind every verdict the app shows what the reviews actually
      say: the five most frequent risks, the five most frequent concerns, every signal with its count, and practical
      tips extracted from the same text.
    </p>
    <Notes
      items={[
        { label: 'Problem', text: 'Travelers did not trust a number they could not trace, and venue owners could not argue with it either.' },
        { label: 'Decision', text: 'Verdict first, then a ranked list of risks and concerns, then the full signal list with counts. Reviews themselves are never shown, only what they add up to.' },
      ]}
    />
    <Shots
      max={330}
      shots={[
        { src: img('evidence-1'), alt: 'Verdict plus top 5 risks and concerns' },
        { src: img('evidence-2'), alt: 'All signals with counts' },
        { src: img('evidence-3'), alt: 'Tips: what to expect, how to prepare, who it is for' },
      ]}
    />
  </Section>

  <!-- 08 · Explainer before and after -->
  <Section n="06" tone="white" eyebrow="Iteration · Explaining the score" title="From a wall of text to a scale you can read">
    <p slot="lead">
      The first app had no explanation of the scores at all. On 1 May a single text modal shipped together with the
      methodology page on goler.co. Four days later it was rebuilt into two steps, one score each.
    </p>
    <div class="ba">
      <Compare before={img('explainer-v1-phone')} after={img('explainer-v2-phone')} beforeLabel="V1 · 1 May" afterLabel="V2 · 5 May" />
      <Notes stack
      items={[
        {
          label: 'V1 · 1 May · what worked, what did not',
          text: [
            '+ Shown automatically on the first visit to the venue list, and again whenever the copy changes.',
            '+ It separated the two scores: Risk and Quality answer different questions.',
            '− Text only: no scale and no example, so a number like 57 stayed abstract.',
            '− Quality was described as "aggregate visitor satisfaction across all ratings", close to the average rating the product argues against.',
            '− No way to the full methodology from the app.',
          ],
        },
        {
          label: 'V2 · 5 May · what works, what it costs',
          text: [
            '+ Two steps, one score each, with a "1 of 2" indicator.',
            '+ A worked example: a score on a five-zone color scale with a marker.',
            '+ Risk zones spelled out, 0–20 Clean to 80+ Critical, each with one line of meaning.',
            '+ Quality broken down into its five axes, and a link to the full methodology.',
            '− Longer: two screens to read before the first results.',
          ],
        },
      ]}
    />
    </div>
  </Section>

  <!-- 09 · Explain the score -->
  <Section n="07" tone="sand" eyebrow="Solution · Understanding" title="Explain the score once, then get out of the way">
    <p slot="lead">
      The explainer is shown once, on the first visit, and again only when its copy changes. Everywhere else the
      scores speak for themselves.
    </p>
    <Notes
      items={[
        { label: 'Problem', text: 'Risk was read as a probability. The city-wide "concerns" number on Home was confused with a venue\'s Risk score.' },
        { label: 'Decision', text: 'Risk is explained as how systematic the signals are, with five color zones and a real example. The city metric got its own name, its own place on Home and its own copy, so it never looks like a venue score.' },
      ]}
    />
    <div class="split">
      <Zoom src={img('explain-phones')} alt="How Risk works and How Quality works, the two steps of the explainer" widths={[632, 1264]} sizes="(max-width: 760px) 100vw, 632px" />
      <Zoom src={img('explain-right')} alt="Traveler concerns in Batumi as a separate city metric on Home, and a venue page with not enough reviews for analysis" widths={[480, 960]} sizes="(max-width: 760px) 100vw, 480px" />
    </div>
  </Section>

  <!-- 10 · Search -->
  <Section n="08" tone="white" eyebrow="Solution · Search" title="Start from the verdict, not from the map">
    <p slot="lead">
      Search is where people compare. Every result card carries Risk and Quality, distance and price, so the shortlist
      is already filtered by what matters.
    </p>
    <Notes
      items={[
        { label: 'Before', text: 'Tapping search on Home opened a modal that duplicated the Search screen. The placeholder said "Search venues", the same promise as every map app.' },
        { label: 'After', text: 'One tap opens the Search tab with the field already focused. The placeholder says "Check a venue". Filters cover place type, dietary preferences, price and sorting by Risk or Quality.' },
      ]}
    />
    <Shots
      max={256}
      shots={[
        { src: img('search-1'), alt: 'Home: Check a venue' },
        { src: img('search-2'), alt: 'Results with Risk and Quality' },
        { src: img('search-3'), alt: 'Sort by risk or quality' },
        { src: img('search-4'), alt: 'Dietary preferences' },
      ]}
    />
  </Section>

  <!-- 11 · AI search -->
  <Section n="09" tone="dark" eyebrow="Experiment · AI search" title="An assistant that behaves like a filter. Shipped, then cut">
    <p slot="lead">
      The first version was a separate chat assistant. It was rebuilt as "AI search": a mode inside Search that asks
      for the missing pieces one at a time and returns ordinary result cards. Then real usage answered the question the
      design could not.
    </p>
    <Notes
      items={[
        { label: 'Problem', text: 'A free-form chat put the burden on the traveler: what to type, how specific to be, what to do with a paragraph of text.' },
        { label: 'Decision', text: 'Slot filling. One sentence in, then the app asks for what it still needs: district, cuisine, dish. Results come back as the same cards as regular search, with Risk and Quality on each.' },
      ]}
    />
    <Shots
      max={256}
      shots={[
        { src: img('ai-1'), alt: 'Describe the evening' },
        { src: img('ai-2'), alt: 'The app asks for the missing piece' },
        { src: img('ai-3'), alt: 'Searching' },
        { src: img('ai-4'), alt: 'Checked results, same cards' },
      ]}
    />
    <div class="result">
      <p class="result-label">Result</p>
      <p>Not one real user opened AI search, so it was removed from the app. It stays in this case because cutting it was a design decision too.</p>
    </div>
  </Section>

  <!-- 12 · Honest states -->
  <Section n="10" tone="sand" eyebrow="Solution · Edge cases" title="When the data is thin, say so">
    <p slot="lead">
      A trust product cannot bluff. Every part of the app has designed states for loading, empty, error and "not
      enough data", and the copy explains why instead of hiding it.
    </p>
    <Shots
      max={200}
      shots={[
        { src: img('states-1'), alt: 'Not enough reviews for analysis' },
        { src: img('states-2'), alt: 'No score yet' },
        { src: img('states-3'), alt: 'No places found' },
        { src: img('states-4'), alt: 'Location not shared' },
        { src: img('states-5'), alt: 'Failed to load' },
      ]}
    />
  </Section>

  <!-- 13 · Reviews -->
  <Section n="11" tone="white" eyebrow="Solution · Feedback" title="Feedback without pretending">
    <p slot="lead">
      A star and a text box ask people to perform. Most of them pick 5, a few vent. Goler asks what actually stood
      out, per axis, and lets the app do the writing.
    </p>
    <Notes
      items={[
        { label: 'Problem', text: 'Free-text reviews are hard to write and even harder to score consistently. A single star hides what was good and what was wrong.' },
        { label: 'Decision', text: 'Three buckets, Standouts, Recommended, Mixed, each with the same axes the scores use. A visit becomes structured signals from the first tap. Written up in the blog post "How we improved review UX by not asking people to pretend".' },
      ]}
    />
    <Shots
      shots={[
        { src: img('reviews-1'), alt: 'Leave a review by axis' },
        { src: img('reviews-2'), alt: 'Add photos' },
        { src: img('reviews-3'), alt: 'Gallery with moderation status' },
      ]}
    />
  </Section>

