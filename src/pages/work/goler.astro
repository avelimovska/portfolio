  /* ---------- 20 Outcome ---------- */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: -24px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .pill:hover {
    background: #a3004a;
  }

  /* ---------- 21 Thanks ---------- */
  .thanks {
    padding: clamp(120px, 14vw, 200px) 0;
    background: var(--accent);
    color: #fff;
    text-align: center;
  }
  .thanks h2 {
    font-size: clamp(44px, 6.4vw, 80px);
    line-height: 1;
  }
  .thanks p {
    margin-top: 20px;
    font-size: clamp(17px, 1.6vw, 20px);
    color: rgb(255 255 255 / 0.75);
  }
  .hero-note {
    margin-top: 16px;
    max-width: 46em;
    font-size: 13px;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.7);
  }
  .thanks .thanks-note {
    max-width: 40em;
    margin: 32px auto 0;
    font-size: 13px;
    color: rgb(255 255 255 / 0.65);
