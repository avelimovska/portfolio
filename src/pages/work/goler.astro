  .thanks-back:hover {
    border-color: #fff;
  }

  /* ---------- Lightbox ---------- */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 64px 1fr 64px;
    align-items: center;
    background: rgb(3 7 18 / 0.94);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .lb[hidden] {
    display: none;
  }
  .lb.open {
    opacity: 1;
  }
  .lb-fig {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin: 0;
    max-height: 100vh;
    padding: 56px 0 32px;
  }
  .lb-img {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    object-fit: contain;
    transform: scale(0.96);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .lb.open .lb-img {
    transform: none;
  }
  .lb-cap {
    font-size: 14px;
    color: #9ca3af;
    text-align: center;
  }
  .lb-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0 auto;
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: 50%;
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    font-size: 18px;
    cursor: pointer;
    transition: background 0.2s ease;
  }
  .lb-btn:hover {
    background: var(--accent);
    border-color: var(--accent);
  }
  .lb-close {
    position: absolute;
    top: 16px;
    right: 16px;
  }
  .lb-prev {
    grid-column: 1;
  }
  .lb-next {
    grid-column: 3;
  }
  .lb.single .lb-prev,
  .lb.single .lb-next {
    visibility: hidden;
  }

  @media (max-width: 600px) {
    .lb {
      grid-template-columns: 0 1fr 0;
    }
    .lb-prev,
    .lb-next {
      position: absolute;
      bottom: 16px;
    }
    .lb-prev {
      left: calc(50% - 56px);
    }
    .lb-next {
      left: calc(50% + 12px);
    }
    .lb-fig {
      padding: 64px 12px 80px;
    }
  }

  @media (max-width: 600px) {
    .bar-val,
    .bar-label {
      font-size: 9px;
