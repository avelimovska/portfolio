<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal headers and blocks as they scroll into view.
  const revealTargets = document.querySelectorAll<HTMLElement>('[data-reveal], .band .body > *');
  revealTargets.forEach((el) => el.setAttribute('data-reveal', ''));
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
  );
  revealTargets.forEach((el) => io.observe(el));

  // Count the big numbers up when they appear.
  const counters = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        counters.unobserve(e.target);
        const el = e.target as HTMLElement;
        const to = Number(el.dataset.count);
        const suffix = el.dataset.suffix ?? '';
        if (reduce) return;
        const t0 = performance.now();
        const dur = 1200;
        const tick = (t: number) => {
          const k = Math.min(1, (t - t0) / dur);
          el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3))) + suffix;
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      }),
    { threshold: 0.6 },
  );
  document.querySelectorAll('[data-count]').forEach((el) => counters.observe(el));

  // Grow the chart bars when the chart is on screen.
  const bars = document.querySelector('.bars');
  if (bars) {
    const bo = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          bars.classList.add('in');
          bo.disconnect();
        }
      },
      { threshold: 0.35 },
    );
    bo.observe(bars);
  }

  // Chapter bar: highlight the chapter on screen and show reading progress.
  const nav = document.querySelector<HTMLElement>('.chapters');
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('.chapters a')].map((a) => [a.dataset.target, a]),
  );
  // A chapter stays active until the next chapter's section reaches the middle of the screen.
  const chapterSections = [...document.querySelectorAll<HTMLElement>('section[data-chapter]')];
  let current = '';
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - innerHeight;
    nav?.style.setProperty('--p', String(max > 0 ? scrollY / max : 0));
    let id = '';
    for (const sec of chapterSections) if (sec.getBoundingClientRect().top < innerHeight * 0.4) id = sec.id;
    if (id === current) return;
    current = id;
    links.forEach((a) => a.classList.remove('active'));
    const a = links.get(id);
    if (a) {
      a.classList.add('active');
      a.parentElement?.scrollTo({ left: a.offsetLeft - 24, behavior: 'smooth' });
    }
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Hero phones follow the pointer a little.
  const hero = document.querySelector<HTMLElement>('.hero');
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (hero && tilt && !reduce && matchMedia('(hover: hover)').matches) {
    hero.addEventListener('pointermove', (ev) => {
      const r = hero.getBoundingClientRect();
      const x = (ev.clientX - r.left) / r.width - 0.5;
      const y = (ev.clientY - r.top) / r.height - 0.5;
      tilt.style.setProperty('--ry', `${x * 10}deg`);
      tilt.style.setProperty('--rx', `${-y * 8}deg`);
    });
    hero.addEventListener('pointerleave', () => {
      tilt.style.setProperty('--ry', '0deg');
      tilt.style.setProperty('--rx', '0deg');
    });
  }

  // Venue page: the callout list and the numbers on the screen light up together.
  const items = [...document.querySelectorAll<HTMLElement>('[data-callouts] li')];
  const spots = [...document.querySelectorAll<HTMLElement>('.hotspot')];
  let auto: number | undefined;
  const light = (i: number) => {
    items.forEach((li, j) => li.classList.toggle('on', j === i));
    spots.forEach((s, j) => s.classList.toggle('on', j === i));
  };
  const stopAuto = () => {
    if (auto) clearInterval(auto);
    auto = undefined;
  };
  items.forEach((li, i) => li.addEventListener('mouseenter', () => (stopAuto(), light(i))));
  spots.forEach((s, i) => {
    s.addEventListener('mouseenter', () => (stopAuto(), light(i)));
    s.addEventListener('click', () => (stopAuto(), light(i)));
  });
  const annotated = document.querySelector('.annotated');
  if (annotated && items.length) {
    const ao = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting || auto || reduce) return;
        let i = 0;
        light(0);
        auto = window.setInterval(() => light((i = (i + 1) % items.length)), 2200);
        ao.disconnect();
      },
      { threshold: 0.5 },
    );
    ao.observe(annotated);
  }

  // Lightbox.
  const lb = document.querySelector<HTMLElement>('.lb')!;
  const lbImg = lb.querySelector<HTMLImageElement>('.lb-img')!;
  const lbCap = lb.querySelector<HTMLElement>('.lb-cap')!;
  let group: HTMLElement[] = [];
  let idx = 0;
  let opener: HTMLElement | null = null;
  const show = (i: number) => {
    idx = (i + group.length) % group.length;
    const b = group[idx];
    lbImg.src = b.dataset.full!;
    lbImg.alt = b.dataset.alt ?? '';
    const caption = b.dataset.caption === 'false' ? '' : (b.dataset.alt ?? '');
    const count = group.length > 1 ? `${idx + 1} / ${group.length}` : '';
    lbCap.textContent = [caption, count].filter(Boolean).join('  ·  ');
  };
  const open = (b: HTMLElement) => {
    opener = b;
    group = [...document.querySelectorAll<HTMLElement>(`.zoom[data-group="${CSS.escape(b.dataset.group ?? '')}"]`)];
    lb.classList.toggle('single', group.length < 2);
    show(group.indexOf(b));
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
    requestAnimationFrame(() => lb.classList.add('open'));
    lb.querySelector<HTMLElement>('.lb-close')!.focus();
  };
  const close = () => {
    lb.classList.remove('open');
    document.body.style.overflow = '';
    setTimeout(() => (lb.hidden = true), 200);
    opener?.focus();
  };
  document.querySelectorAll<HTMLElement>('.zoom').forEach((b) => b.addEventListener('click', () => open(b)));
  lb.querySelector('.lb-close')!.addEventListener('click', close);
  lb.querySelector('.lb-prev')!.addEventListener('click', () => show(idx - 1));
  lb.querySelector('.lb-next')!.addEventListener('click', () => show(idx + 1));
  lb.addEventListener('click', (e) => {
    if (e.target === lb || (e.target as HTMLElement).classList.contains('lb-fig')) close();
  });
  addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>

