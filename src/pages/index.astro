---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../data/profile';
import { projects } from '../data/projects';

// The photo is optional: drop src/assets/anna.jpg (or .png / .webp) and set hasPhoto: true.
const photos = import.meta.glob<{ default: ImageMetadata }>('../assets/anna.{jpg,jpeg,png,webp}', {
  eager: true,
});
const photo = profile.hasPhoto ? Object.values(photos)[0]?.default : undefined;

const { links } = profile;
const contacts = [
  links.email && { label: 'Email', href: `mailto:${links.email}` },
  links.linkedin && { label: 'LinkedIn', href: links.linkedin },
  links.behance && { label: 'Behance', href: links.behance },
  links.cv && { label: 'CV', href: links.cv },
].filter(Boolean) as { label: string; href: string }[];

---

<Base>
  <section class="intro wrap">
    <h1 class="display">
      {profile.intro} <span class="muted">{profile.introMuted}</span>
    </h1>

    <dl class="facts">
      <div>
        <dt>Currently</dt>
        <dd>{profile.currently}</dd>
      </div>
      <div>
        <dt>Focus</dt>
        <dd>{profile.facts.find((f) => f.label === 'Focus')?.value}</dd>
      </div>
      {
        contacts.length > 0 && (
          <div>
            <dt>Contact</dt>
            <dd class="links">
              {contacts.map((c) => (
                <a href={c.href} target={c.href.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
                  {c.label}
                </a>
              ))}
            </dd>
          </div>
        )
      }
    </dl>
  </section>

  <section id="work" class="work wrap">
    <div class="section-label">
      <h2>Selected work</h2>
      <span>{String(projects.length).padStart(2, '0')}</span>
    </div>
    <div class="grid">
      {projects.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
  </section>

  <section id="about" class="about wrap">
    <div class="about-side">
      <h2 class="section-title">About</h2>
      {photo && <Image class="photo" src={photo} alt={profile.name} widths={[320, 480, 640]} sizes="280px" />}
    </div>
    <div class="about-main">
      <div class="about-text">
        {profile.about.map((p) => <p>{p}</p>)}
      </div>

      <dl class="table">
        <div class="row">
          <dt>Experience</dt>
          <dd>
            {
              profile.experience.map((e) => (
                <span class="exp">
                  <span>
                    {e.title}, {e.org}
                  </span>
                  <span class="muted">{e.period}</span>
                </span>
              ))
            }
          </dd>
        </div>
        {
          profile.facts
            .filter((f) => f.label !== 'Focus')
            .map((f) => (
              <div class="row">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
        }
      </dl>
    </div>
  </section>

  {
    links.email && (
      <section class="contact wrap">
        <p class="contact-label">Have a role in mind?</p>
        <a class="contact-mail display" href={`mailto:${links.email}`}>
          {links.email}
        </a>
      </section>
    )
  }
</Base>

<style>
  .muted {
    color: var(--ink-3);
  }

  /* ---------- Intro ---------- */
  .intro {
    padding-top: clamp(72px, 12vw, 160px);
    padding-bottom: clamp(64px, 9vw, 120px);
  }
  h1 {
    max-width: 21em;
    font-size: clamp(30px, 4.2vw, 56px);
    line-height: 1.08;
  }
  .facts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin: clamp(40px, 6vw, 72px) 0 0;
    font-size: 14px;
  }
  .facts dt {
    color: var(--ink-3);
  }
  .facts dd {
    margin: 4px 0 0;
    color: var(--ink);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .links a {
    text-decoration: underline;
    text-decoration-color: var(--line);
  }
  .links a:hover {
    text-decoration-color: currentColor;
  }

  /* ---------- Work ---------- */
  .work {
    scroll-margin-top: 64px;
  }
  .section-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    color: var(--ink-3);
  }
  .section-label h2 {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 56px 32px;
    margin-top: 32px;
  }

  /* ---------- About ---------- */
  .about {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding-top: clamp(96px, 12vw, 160px);
    padding-bottom: clamp(96px, 12vw, 160px);
    scroll-margin-top: 64px;
  }
  .section-title {
    font-size: 14px;
    font-weight: 500;
  }
  :global(.photo) {
    width: 100%;
    max-width: 280px;
    margin-top: 24px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .about-text {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 36em;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.5;
    letter-spacing: -0.01em;
  }
  .table {
    margin: 56px 0 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .row dt {
    color: var(--ink-3);
  }
  .row dd {
    margin: 0;
  }
  .exp {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 16px;
  }

  /* ---------- Contact ---------- */
  .contact {
    padding-bottom: clamp(96px, 12vw, 160px);
  }
  .contact-label {
    font-size: 14px;
    color: var(--ink-3);
  }
  .contact-mail {
    display: inline-block;
    margin-top: 12px;
    font-size: clamp(28px, 5vw, 64px);
    line-height: 1.1;
    text-decoration: none;
    border-bottom: 2px solid var(--line);
    transition: border-color 0.2s ease;
  }
  .contact-mail:hover {
    border-color: currentColor;
  }

  @media (min-width: 760px) {
    .facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 900px;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-template-columns: 1fr 2fr;
      gap: 32px;
    }
    .row {
      grid-template-columns: 1fr 2fr;
      gap: 24px;
    }
  }
</style>
