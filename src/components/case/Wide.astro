---
// One large image (browser screens, boards), optionally with a caption under it.
import type { ImageMetadata } from 'astro';
import Zoom from './Zoom.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  group?: string;
}
const { src, alt, caption, group = 'wide' } = Astro.props;
---

<figure class="wide">
  <Zoom src={src} alt={alt} group={group} widths={[640, 960, 1280, 1920]} sizes="(max-width: 1192px) 100vw, 1160px" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .wide {
    margin: 0;
    --zoom-scale: 1.015;
  }
  figcaption {
    margin-top: 12px;
    font-size: 13px;
    color: var(--ink-3);
  }
</style>
