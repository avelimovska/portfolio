---
// Before / after slider: drag (or use the arrow keys) to reveal one screen over the other.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  before: ImageMetadata;
  after: ImageMetadata;
  beforeLabel: string;
  afterLabel: string;
}
const { before, after, beforeLabel, afterLabel } = Astro.props;
---

<div class="compare" style="--pos:50%">
  <div class="stage">
    <Image class="img after" src={after} alt={afterLabel} widths={[400, 600]} sizes="340px" loading="lazy" />
    <div class="before-wrap" aria-hidden="true">
      <Image class="img before" src={before} alt="" widths={[400, 600]} sizes="340px" loading="lazy" />
    </div>
    <div class="handle" aria-hidden="true">
      <span class="knob">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 6l-6 6 6 6M15 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </div>
    <input class="range" type="range" min="0" max="100" value="50" aria-label={`Compare: ${beforeLabel} and ${afterLabel}`} />
  </div>
  <div class="labels">
    <button type="button" class="tag" data-to="100">{beforeLabel}</button>
    <button type="button" class="tag" data-to="0">{afterLabel}</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.compare').forEach((el) => {
    const range = el.querySelector<HTMLInputElement>('.range')!;
    const set = (v: number) => {
      el.style.setProperty('--pos', `${v}%`);
      range.value = String(v);
      el.dataset.side = v > 66 ? 'before' : v < 34 ? 'after' : '';
    };
    range.addEventListener('input', () => set(Number(range.value)));
    el.querySelectorAll<HTMLButtonElement>('.tag').forEach((b) =>
      b.addEventListener('click', () => {
        el.classList.add('animating');
        set(Number(b.dataset.to));
        setTimeout(() => el.classList.remove('animating'), 500);
      }),
    );
  });
</script>

<style>
  .compare {
    width: 100%;
    max-width: 340px;
    margin: 0 auto;
  }
  .stage {
    position: relative;
    user-select: none;
    touch-action: pan-y;
  }
  .stage :global(.img) {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }
  .before-wrap {
    position: absolute;
    inset: 0;
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--accent);
    pointer-events: none;
  }
  .knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -22px 0 0 -22px;
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    box-shadow: 0 8px 24px rgb(191 0 86 / 0.35);
  }
  .animating .before-wrap {
    transition: clip-path 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .animating .handle {
    transition: left 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .range:focus-visible + * {
    outline: none;
  }
  .stage:has(.range:focus-visible) .knob {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .labels {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 16px;
  }
  .tag {
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .compare[data-side='before'] .tag[data-to='100'],
  .compare[data-side='after'] .tag[data-to='0'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
</style>
