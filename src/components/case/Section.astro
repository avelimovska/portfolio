---
// One module of a case study: a full-width band with an eyebrow, a title and an optional lead.
// `tone` sets the band background; cards and labels inside pick their colors from it.
// `chapter` adds the module to the chapter bar at the top of the page.
interface Props {
  eyebrow?: string;
  title?: string;
  tone?: 'white' | 'sand' | 'dark';
  id?: string;
  n?: string;
  chapter?: string;
}
const { eyebrow, title, tone = 'white', id, n, chapter } = Astro.props;
---

<section class:list={['band', `tone-${tone}`]} id={id} data-chapter={chapter} data-tone={tone}>
  <div class="wrap">
    {
      (eyebrow || title) && (
        <header class:list={['head', { split: Astro.slots.has('lead') }]} data-reveal>
          <div class="head-main">
            {eyebrow && (
              <p class="kicker">
                {n && <span class="n">{n}</span>}
                {eyebrow}
              </p>
            )}
            {title && <h2 class="display">{title}</h2>}
          </div>
          {Astro.slots.has('lead') && (
            <div class="lead">
              <slot name="lead" />
            </div>
          )}
        </header>
      )
    }
    <div class="body">
      <slot />
    </div>
  </div>
</section>

<style>
  .band {
    padding: clamp(80px, 10vw, 140px) 0;
    background: var(--band);
    color: var(--ink);
    scroll-margin-top: 108px;
  }
  .tone-white {
    --band: #ffffff;
    --card: var(--sand, #f5f5f0);
  }
  .tone-sand {
    --band: var(--sand, #f5f5f0);
    --card: #ffffff;
  }
  .tone-dark {
    --band: #030712;
    --card: #111827;
    --card-line: #1f2937;
    --ink: #ffffff;
    --ink-2: #9ca3af;
    --ink-3: #6b7280;
    --line: #1f2937;
    --kicker: #9ca3af;
    --ps-label: #f59e0b;
  }
  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kicker, var(--accent));
  }
  .n {
    display: inline-grid;
    place-items: center;
    min-width: 28px;
    height: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--accent);
    color: #fff;
    font-size: 11px;
    letter-spacing: 0.02em;
  }
  h2 {
    margin-top: 18px;
    max-width: 14em;
    font-size: clamp(34px, 4.8vw, 58px);
    line-height: 1.02;
  }
  .lead {
    margin-top: 20px;
    max-width: 640px;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.65;
    color: var(--ink-2);
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }
  .head + .body {
    margin-top: clamp(40px, 5.5vw, 72px);
  }
  @media (min-width: 1000px) {
    .head.split {
      display: grid;
      grid-template-columns: 7fr 5fr;
      gap: 64px;
      align-items: end;
    }
    .head.split .lead {
      margin-top: 0;
    }
  }
</style>
