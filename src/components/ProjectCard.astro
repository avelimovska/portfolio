---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;
const href = `${import.meta.env.BASE_URL}work/${project.slug}/`;
---

<a class:list={['project', { featured }]} href={href}>
  <div class="cover" style={`--accent:${project.accent}`}>
    <Image
      src={project.cover}
      alt={project.coverAlt ?? `${project.title}: app screens`}
      widths={[560, 840, 1126]}
      sizes={featured ? '(max-width: 900px) 100vw, 680px' : '(max-width: 760px) 100vw, 600px'}
      loading={index === 0 ? 'eager' : 'lazy'}
    />
  </div>
  <div class="caption">
    <h3>{project.title}</h3>
    <p class="summary">{project.summary}</p>
    <p class="meta">
      <span>{project.platforms}</span>
      <span>{project.year}</span>
    </p>
  </div>
</a>

<style>
  .project {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .cover {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--accent);
  }
  .featured .cover {
    aspect-ratio: 16 / 9;
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .project:hover .cover :global(img) {
    transform: scale(1.03);
  }
  .caption {
    display: grid;
    grid-template-columns: 1fr;
    gap: 6px;
    padding-top: 20px;
  }
  h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .summary {
    max-width: 62ch;
    font-size: 15px;
    color: var(--ink-2);
  }
  .meta {
    display: flex;
    gap: 16px;
    font-size: 13px;
    color: var(--ink-3);
  }
  @media (min-width: 900px) {
    .featured .caption {
      grid-template-columns: 3fr 6fr 3fr;
      gap: 24px;
      align-items: baseline;
    }
    .featured .meta {
      justify-content: flex-end;
    }
  }
</style>
